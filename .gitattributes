# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Jupyter Notebooks — always LF
*.ipynb text eol=lf

# CSV files — treat as binary to avoid any line-ending changes
*.csv binary

# Python source files — LF
*.py text eol=lf

# Common config / markup files — LF
*.md text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
.gitattributes
